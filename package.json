{
  "name": "@mintahandrews/studymate",
  "version": "0.0.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/mintahandrews/StudyMate.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "android:sync": "npm run build && npx cap sync android",
    "android:dev": "cross-env CAP_LIVE_RELOAD=1 npx cap sync android",
    "android:open": "npx cap open android",
    "test:mobile:open": "npx cypress open --config viewportWidth=360,viewportHeight=800",
    "test:mobile:run": "npx cypress run --config viewportWidth=360,viewportHeight=800",
    "test:native:run": "wdio run wdio.conf.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.2.1",
    "@supabase/supabase-js": "^2.39.7",
    "date-fns": "^3.3.1",
    "lucide-react": "^0.358.0",
    "mammoth": "^1.7.0",
    "pdfjs-dist": "^4.8.69",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.3.5",
    "react-hot-toast": "^2.4.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.22.3",
    "react-syntax-highlighter": "^15.5.0",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@tailwindcss/typography": "^0.5.10",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@types/react-syntax-highlighter": "^15.5.11",
    "@vitejs/plugin-react": "^4.3.1",
    "@wdio/cli": "^9.29.1",
    "@wdio/local-runner": "^9.29.1",
    "@wdio/mocha-framework": "^9.29.1",
    "@wdio/spec-reporter": "^9.29.1",
    "appium": "^3.5.2",
    "appium-uiautomator2-driver": "^8.1.0",
    "autoprefixer": "^10.4.17",
    "cross-env": "^10.1.0",
    "cypress": "^15.17.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "terser": "^5.37.0",
    "typescript": "^5.4.2",
    "vite": "^5.1.5",
    "webdriverio": "^9.29.1"
  }
}
